{
  "manifest_version": 3,
  "name": "paintBrush",
  "version": "1.2.0",
  "description": "150 offline coloring pages for ages 2-9. Tap to color, stickers, color-by-number, shiny crayons. No ads, no tracking.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Open paintBrush", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"]
}
